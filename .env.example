# CineMatch AI Configuration Variables

# 1. API Keys (Optional, but recommended for fetching posters)
# Get a free API key by signing up at https://www.themoviedb.org/
TMDB_API_KEY=your_tmdb_api_key_here

# Keep False for free hosting. True requires enough RAM for PyTorch and SentenceTransformers.
ENABLE_SEMANTIC_MODEL=False

# 2. Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# 3. Recommendation Dataset Mode
# Set to True to use a smaller 500-movie subset of MovieLens for low-memory/low-performance testing.
# Set to False (default) to load the complete ~3,500 movies and ~70,000 rating interactions.
USE_SAMPLE_DATASET=False
